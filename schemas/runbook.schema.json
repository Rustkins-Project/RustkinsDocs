{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Rustkins-Project/RustkinsDocs/blob/main/schemas/runbook.schema.json",
  "title": "Rustkins runbook frontmatter",
  "description": "Métadonnées des procédures publiées sous docs/operations/ ; les sections Markdown sont contrôlées séparément.",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "title", "type", "status", "summary", "topics", "applies_to"],
  "properties": {
    "id": {"type": "string", "pattern": "^RUN-[0-9]{4,}$"},
    "title": {"type": "string", "minLength": 1},
    "type": {"const": "operation"},
    "status": {"enum": ["draft", "approved", "deprecated"]},
    "summary": {"type": "string", "minLength": 1, "maxLength": 500},
    "topics": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "applies_to": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "pattern": "^(V[0-9]+|all)$"}},
    "related_adrs": {"type": "array", "uniqueItems": true, "items": {"type": "string", "pattern": "^ADR-[0-9]{4,}$"}},
    "related_work_items": {"type": "array", "uniqueItems": true, "items": {"type": "integer", "minimum": 1}},
    "related_docs": {"type": "array", "uniqueItems": true, "items": {"type": "string", "pattern": "^(DOC|RUN)-[0-9]{4,}$"}},
    "references": {"type": "array", "uniqueItems": true, "items": {"type": "string", "format": "uri"}}
  },
  "allOf": [
    {
      "if": {"properties": {"applies_to": {"contains": {"const": "all"}}}, "required": ["applies_to"]},
      "then": {"properties": {"applies_to": {"maxItems": 1}}}
    }
  ]
}

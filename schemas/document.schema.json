{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Rustkins-Project/RustkinsDocs/blob/main/schemas/document.schema.json",
  "title": "Rustkins document frontmatter",
  "description": "Validation des métadonnées YAML, préalablement converties en objet JSON, pour les documents Markdown de référence sous docs/, à l'exclusion des fichiers README.md ; ne valide ni le contenu du Markdown ni l'approbation humaine.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "title",
    "type",
    "status",
    "summary",
    "topics",
    "applies_to"
  ],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^DOC-[0-9]{4,}$"
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "type": {
      "type": "string",
      "enum": [
        "architecture",
        "specification",
        "convention",
        "operation",
        "project-management",
        "version",
        "cross-cutting"
      ]
    },
    "status": {
      "type": "string",
      "enum": [
        "draft",
        "approved",
        "deprecated"
      ]
    },
    "summary": {
      "type": "string",
      "minLength": 1,
      "maxLength": 500
    },
    "topics": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "applies_to": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^(V[0-9]+|all)$"
      }
    },
    "specification_version": {
      "type": "string",
      "minLength": 1
    },
    "related_adrs": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^ADR-[0-9]{4,}$"
      }
    },
    "related_work_items": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "integer",
        "minimum": 1
      }
    },
    "related_docs": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "references": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "format": "uri"
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "applies_to": {
            "contains": {
              "const": "all"
            }
          }
        },
        "required": [
          "applies_to"
        ]
      },
      "then": {
        "properties": {
          "applies_to": {
            "maxItems": 1
          }
        }
      }
    }
  ]
}
